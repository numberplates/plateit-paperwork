{% set random = random(1, 1000000) %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Print Integrated Labels</title>
    <link rel="stylesheet" href="public/css/integrated-label.css?v={{ random }}">
</head>
<body>
    {% for package in packages %}
        <article>

            {# Labels #}
            {{ include('/partials/integrated-label-labels.twig', { 'package': package }) }}
            
            <h1>Packing Slip</h1>
            <p>
                Order ID: {{ package.order_id }} <br>
                Package ID: {{ package.id }}
            </p>

            {# Plates #}
            {% if package.plates|length %}
                {{ include('/partials/integrated-label-plates.twig', { 'plates': package.plates }) }}
            {% endif %}

            {# Extra Products #}
            {% if package.products|length %}
                {{ include('/partials/integrated-label-products.twig', { 'products': package.products }) }}
            {% endif %}
            
            {# Notes #}
            {% if package.notes|length %}
                {{ include('/partials/integrated-label-notes.twig', { 'notes': package.notes }) }}
            {% endif %}

        </article>

        {# Insert page break #}
        {% if not loop.last %}
            <div class="page-break"></div>
        {% endif %}

    {% endfor %}
</body>
</html>