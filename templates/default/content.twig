{# Header #}
{{
    include('/default/header.twig', {
        'company': package.order.company,
        'customer': package.order.customer,
        'ship_to': get_correct_ship_to_address(package)
    })
}}

<h1>
    Packing Slip
    {% if package.shipping.system_courier_service.priority_level == 1 %}
        <strong class="important">- PRIORITY MAIL</strong>
    {% endif %}
</h1>

{# Summary #}
{{ include('/default/summary.twig', { 'package': package }) }}

{# Plates #}
{% if package.plates|length %}
    {{ include('/default/plates.twig', { 'plates': package.plates }) }}
{% endif %}

{# Extras #}
{% if package.products|length %}
    {{ include('/default/products.twig', { 'products': package.products }) }}
{% endif %}

{# Notes #}
{% if package.notes|filter(note => not note.is_private)|length %}
    {{ include('/default/notes.twig', { 'notes': package.notes }) }}
{% endif %}