<section class="items extras">
    <h2>Extras</h2>
    <table>
        <tr>
            <th>Item</th>
            <th>SKU</th>
            <th>QTY</th>
        </tr>
        {% for product in products %}
        <tr>
            <td>{{ product.name }}</td>
            <td>{{ product.sku|upper }}</td>
            <td class="qty {{ product.qty > 1 ? 'gt-1' : '' }}">{{ product.qty }}</td>
        </tr>
        {% endfor %}
    </table>
</section>