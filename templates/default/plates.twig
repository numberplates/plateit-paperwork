{% set plates = get_scrutinised_plates(plates) %}
{% set has_scrutinise = plates|filter(plate => plate.scrutinise is not null)|length > 0 %}
{% set has_instructions = plates|filter(plate => plate.custom_instructions is not null)|length > 0 %}
{% set has_shape = plates|filter(plate => plate.shape is not null)|length > 0 %}

<section class="items plates">
    <h2>
        Plates
        {% if has_scrutinise %}
            <strong class="important">- DIFFERENCES DETECTED</strong>
        {% endif %}
    </h2>
    <table>
        <tr>
            <th>Plate</th>
            <th>QTY</th>
            <th>Preview</th>
            {% if has_scrutinise %}
                <th class="important">Key Differences*</th>
            {% endif %}
            {% if has_instructions %}
                <th>Instructions</th>
            {% endif %}
        </tr>
        {% for plate in plates %}
        <tr class="type-{{ plate.type|lower|replace({' ': '-'}) }}">
            <td>
                <p><strong>{{ plate.registration|upper }}</strong></p>
                {% if plate.shape %}
                    <p>{{ plate.shape|capitalize }}</p>
                {% endif %}
                <p>{{ plate.type|capitalize }} {{ plate.width }}x{{ plate.height }}mm ({{ plate.width|mm_to_inches }}x{{ plate.height|mm_to_inches }}in) <strong>{{ plate.colour|capitalize }}</strong></p>
            </td>
            <td class="qty {{ plate.qty > 1 ? 'gt-1' : '' }}">
                {{ plate.qty }}
            </td>
            <td>
                <img alt="Preview {{ plate.registration|upper }}" style="width: 30mm" src="{{ plateit_base_url }}{{ plate.design_preview }}">
            </td>
            {% if has_scrutinise %}
                <td>{{ render_array_list(plate.scrutinise)|raw }}</td>
            {% endif %}
            {% if has_instructions %}
                 <td>{{ plate.custom_instructions }}</td>
            {% endif %}
        </tr>
        {% endfor %}
    </table>

    {% if has_scrutinise %}
        <p class="asterisk">* Staff notes to assist with manufacturing.</p>
    {% endif %}
</section>
