{% set page_margin = '10mm' %}
{% set label_width = '80mm' %}

/* Reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* Body */
html {
    font-size: 62.5%;
}

body {
    font-family: Arial, sans-serif;
    font-size: 10pt;
    line-height: 1.4em;
}

/* Print page styles */
@page { 
    size: 210mm 297mm; /* A4 */
    margin: {{ page_margin }};
}

article {
    width: 210mm;
    padding: {{ page_margin }};
}

@media print {
    article {
        width: auto;
        margin: 0;
        padding: 0;
    }
}

.page-break {
    page-break-after: always;
}

/* Headings */
h1, h2, h3, h4 {
    margin-bottom: 8mm;
}

/* Description lists */
dl {
    display: grid;
    grid-template-columns: max-content auto;
}

dt {
    grid-column-start: 1;
    font-weight: bold;
    margin-right: 3mm;
}

dd {
    grid-column-start: 2;
}

/* Flex columns */
.flex {
    display: flex;
    justify-content: space-between;
}

/* Integrated labels */
img.label {
    width: {{ label_width }};
}

/* Sections */
section, header {
    margin-bottom: 10mm;
}

/* Header section */
.customer-address {
    width: 40%;
}

/* Summary section */
.summary-notice {
    width: 40%;
}

/* Items section */
.items table {
    width: 100%;
    border-collapse: collapse;
}

.items th, .items td {
    border: 1px solid #ddd;
    padding: 5pt;
    text-align: left;
}

.items th {
    background-color: #f0f0f0;
}

/* Plates grid */
.grid {
    column-count: 2;
    column-gap: 5mm;
}

.grid-item {
    break-inside: avoid;
    margin-bottom: 5mm;
    padding: 3mm;
    border: 1px solid #ddd;
}

.grid-item img {
    width: 100%;
    height: auto;
    margin-bottom: 3mm;
}

/* Notes section */
blockquote {
    border-left: 2px solid #ccc;
    padding-left: 10pt;
    margin: 0 0 5mm 0;
}

cite {
    font-style: italic;
}
