{# Default integrated label styles TBC #}
{% set page_margin = '10mm' %}
{% set label_width = '110mm' %}
{% set label_margin = '37mm 0 0 60mm' %}

{# Alternative integrated label styles #}
{% if integrated_label_type == 'bespoke' %}
    {% set page_margin = '10mm' %}
    {% set label_width = '110mm' %}
    {% set label_margin = '37mm 0 0 60mm' %}
{% endif %}

/* Reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* Body */
html {
    font-size: 62.5%;
}

body {
    font-family: Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.2em;
}

/* Print page styles */
@page { 
    size: 210mm 297mm; /* A4 */
    margin: {{ page_margin }};
}

article {
    width: 210mm;
    padding: {{ page_margin }};
}

@media print {
    article {
        width: auto;
        margin: 0;
        padding: 0;
    }
}

.page-break {
    page-break-after: always;
}

/* Headings */
h1, h2, h3, h4 {
    margin-bottom: 8mm;
}

/* Description lists */
dl {
    display: grid;
    grid-template-columns: max-content auto;
}

dt {
    grid-column-start: 1;
    font-weight: bold;
    margin-right: 3mm;
}

dd {
    grid-column-start: 2;
}

/* Ordered/unordered lists */
ol li, ul li {
    margin-left: 1.5em;
}

/* Flex columns */
.flex {
    display: flex;
    justify-content: space-between;
}

/* Integrated labels */
img.label {
    width: {{ label_width }};
    margin: {{ label_margin }}
}

/* Sections */
section, header {
    margin-bottom: 10mm;
}

/* Header section */
.customer-address {
    width: 40%;
}

/* Summary section */
.summary-notice {
    width: 40%;
}

/* Items section */
.items table {
    width: 100%;
    border-collapse: collapse;
}

.items th, .items td {
    border: 1px solid #ddd;
    padding: 2pt;
    text-align: left;
    vertical-align: top;
}

.items th {
    background-color: #f0f0f0;
}

.items .asterisk {
    margin-top: 1.5em;
    font-style: italic;
}

/* Notes section */
blockquote {
    border-left: 2px solid #ccc;
    padding-left: 10pt;
    margin: 0 0 5mm 0;
}

cite {
    font-style: italic;
}
