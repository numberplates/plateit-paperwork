<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Packing Slips</title>
    <style>
        {{ include('document.css.twig', {'label_config': label_config}) }}
    </style>
    <script>
        /**
        * Called when a label fails to load. It sets the src to a transparent
        * placeholder image and hard codes the width and height of the label
        * boundaries using inline styles to ensure consistency of the page's
        * spacing.
        */
        function handleLabelError(img, widthStr, heightStr) {
            img.onerror = null;
            img.style.width = '100%';
            img.style.height = 'auto';
            img.style.maxWidth = widthStr; 
            img.style.maxHeight = heightStr;
            img.src = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
        }
    </script>
</head>
<body>
    {% for package in packages %}
        <article>

            {# Labels #}
            {{ include('labels.twig', {'package': package, 'label_config': label_config}) }}

            {# Container #}
            {% set template_path = 'company-' ~ package.order.company_id ~ '/content.twig' %}
            {% if template_exists(template_path) %}
                {{ include(template_path, package) }}
            {% else %}
                {{ include('/default/content.twig', package) }}
            {% endif %}

        </article>

        {# Break #}
        {% if not loop.last %}
            <div class="page-break"></div>
        {% endif %}

    {% endfor %}
</body>
</html>