<h2>Plates</h2>


<table class="plates">
    {% for plate in plates %}
        {% if loop.index is odd %}
            <tr>
        {% endif %}
        <td>
            <div>
                <img src="{{ env.PLATEIT_BASE_URL ~ plate.preview_file|strip_slashes }}" alt="{{ plate.registration }} preview">
                <dl>
                    <dt>Registration</dt>
                    <dd>{{ plate.registration }}</dd>
                    <dt>Type</dt>
                    <dd>{{ plate.type|capitalize }}</dd>
                    <dt>Colour</dt>
                    <dd><span class="highlight {{ plate.colour }}">{{ plate.colour|capitalize }}</span></dd>
                    <dt>Size</dt>
                    <dd>{{ plate.width|mm_to_inches }}x{{ plate.height|mm_to_inches }}in <small>({{ plate.width }}x{{ plate.height }}mm)</small></dd>
                    <dt>QTY</dt>
                    <dd><span class="highlight important">{{ plate.qty }}</span></dd>
                </dl>
            </div>
        </td>
        {% if loop.index is even %}
            </tr>
        {% endif %}
    {% endfor %}
    {% if plates|length is odd %}
        <td></td></tr>
    {% endif %}
</table>