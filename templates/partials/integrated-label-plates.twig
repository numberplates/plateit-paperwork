<h2>Plates</h2>

{% for plate in plates %}
<table class="plate">
    <tbody>
        <tr>
            <td class="is-third-page">
                <img src="https://data.plateit.local/v1{{ plate.preview_file }}" alt="{{ plate.registration }} preview">
            </td>
            <td>
                <table class="inner">
                    <tr>
                        <th>Registration</th>
                        <td>{{ plate.registration }}</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>{{ plate.type|capitalize }}</td>
                    </tr>
                    <tr>
                        <th>Colour</th>
                        <td><span class="highlight {{ plate.colour }}">{{ plate.colour|capitalize }}</span></td>
                    </tr>
                    <tr>
                        <th>Width</th>
                        <td>{{ plate.width }}x{{ plate.height }}mm</td>
                    </tr>
                    <tr>
                        <th>QTY</th>
                        <td><span class="highlight important">{{ plate.qty }}</span></td>
                    </tr>
                </table>
            </td>
        <tr>
    </tbody>
</table>
{% endfor %}