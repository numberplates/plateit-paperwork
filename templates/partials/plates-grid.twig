<section class="items plates">
    <h2>Plates</h2>
    <div class="grid">
        {% for plate in plates %}
        <div class="grid-item">
            <img src="{{ env.PLATEIT_BASE_URL ~ plate.preview_file|strip_slashes }}" alt="{{ plate.registration|upper }} preview">
            <div>
                <dl>
                    <dt>Registration</dt>
                    <dd>{{ plate.registration|upper }}</dd>
                    <dt>Type</dt>
                    <dd>{{ plate.type|capitalize }}</dd>
                    <dt>Colour</dt>
                    <dd>{{ plate.colour|capitalize }}</dd>
                    <dt>QTY</dt>
                    <dd>{{ plate.qty }}</dd>
                </dl>
            </div>
        </div>
        {% endfor %}
    </div>
</section>