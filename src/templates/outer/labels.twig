{% set labels_per_page = label_config.labels_per_page|default(1) %}
{% set orientation = label_config.orientation|default('landscape') %}
{% set rotate_degrees = label_config.orientation is same as('portrait') ? 0 : 90 %}
{% set label_filepaths_batched = (package.shipping.label_files|default(['manual_label']))|batch(labels_per_page) %}

{% for batch in label_filepaths_batched %}
    <section class="labels flex">
        {% for label_filepath in batch %}
            {% set image_src = label_filepath == 'manual_label' ? get_fallback_label_image(package) : plateit_base_url ~ label_filepath|strip_slashes ~ '?rotate=' ~ rotate_degrees %}
            <img class="label" alt="label" src="{{ image_src }}" onerror="handleLabelError(this, '{{label_config.label_width}}', '{{label_config.label_height}}')">
        {% endfor %}
    </section>
    {% if not loop.last %}
        <div class="page-break"></div>
    {% endif %}
{% endfor %}