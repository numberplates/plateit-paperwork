<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Packing Slips</title>
    <style>
        {# Runtime label geometry stays under application control. #}
        @page { margin: {{ label_config.page_margin }}; }
        article { padding: {{ label_config.page_margin }}; }
        img.label {
            max-width: {{ label_config.label_width }};
            max-height: {{ label_config.label_height }};
            margin: {{ label_config.label_margin }};
        }
        {{ source('@outer/base.css')|raw }}
        {{ custom_styles|raw }}
    </style>
    <script>
        /**
        * Called when a label fails to load. It sets the src to a transparent
        * placeholder image and hard codes the width and height of the label
        * boundaries using inline styles to ensure consistency of the page's
        * spacing.
        */
        function handleLabelError(img, widthStr, heightStr) {
            img.onerror = null;
            img.style.width = '100%';
            img.style.height = 'auto';
            img.style.maxWidth = widthStr; 
            img.style.maxHeight = heightStr;
            img.src = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
        }
    </script>
</head>
<body>
    {% for package in packages %}
        {% set sequence_number = batch_code ~ '_' ~ loop.index %}
        <article>

            {{ include('@outer/package.twig') }}

        </article>

        {# Break #}
        {% if not loop.last %}
            <div class="page-break"></div>
        {% endif %}

    {% endfor %}
</body>
</html>